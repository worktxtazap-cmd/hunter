async def parse_and_send(client, uid, link, note=''):
    os.makedirs(OUT, exist_ok=True)
    path = os.path.join(OUT, 'demo_%s.csv' % uid)
    ent = await USER.get_entity(link)
    users = await USER.get_participants(ent, limit=1000)
    n = 0
    with open(path, 'w', encoding='utf-8', newline='') as f:
        w = csv.writer(f)
        w.writerow(['id', 'username', 'first_name', 'last_name', 'phone', 'is_bot'])
        for u in users:
            if getattr(u, 'bot', False):
                continue
            w.writerow([u.id, u.username or '', u.first_name or '', u.last_name or '', u.phone or '', 0])
            n += 1
    title = getattr(ent, 'title', link)
    await client.send_file(uid, path, caption='<b>ГОТОВО</b>\n\nчат: %s\nживых контактов: %d%s\n\nтакой файл ты получишь по своему чату. хочешь своего бота? нажми «заказать».' % (title, n, note))

