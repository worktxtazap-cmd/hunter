        p = pr.get(code)
        t = ('$%g' % p) if p is not None else ''
        return Button.inline((name + ' — ' + t).strip(' —'), ('p:' + code).encode())
    def sep(t):
        return Button.inline(t, b'noop')
    rows = [
        [sep('— БОТЫ —')],
        [b('botparser', 'Парсер базы из чата')],
        [b('botkassa', 'Бот-касса')],
